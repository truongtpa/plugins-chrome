{
  "manifest_version": 3,
  "name": "Overleaf Tools",
  "version": "1.2",
  "description": "Bộ công cụ cho Overleaf: gộp dòng vùng chọn và dán nhanh các snip code đã lưu.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "clipboardRead", "storage"],
  "host_permissions": ["https://www.overleaf.com/*"],
  "action": {
    "default_title": "Overleaf Tools",
    "default_popup": "popup.html"
  },
  "commands": {
    "remove-endline": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Gộp dòng vùng đang chọn"
    },
    "open-snip-picker": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Mở bảng chọn snip code đã lưu"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/*"],
      "js": ["content.js"]
    }
  ]
}

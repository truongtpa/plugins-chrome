{
  "manifest_version": 3,
  "name": "Chrome Notes – Ghi chú Markdown nhiều tab",
  "version": "1.2",
  "description": "Ghi chú Markdown nhiều tab, hiển thị trực tiếp khi gõ (live preview): công thức LaTeX, checklist, bảng, tự động lưu.",
  "permissions": ["storage", "sidePanel"],
  "action": {
    "default_title": "Chrome Notes",
    "default_popup": "notes.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "notes.html?mode=panel" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
